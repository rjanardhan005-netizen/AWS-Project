# ============================================================
# .gitignore - Files and folders to exclude from Git
# ============================================================

# Environment variables (contains secrets)
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node.js
node_modules/
frontend/build/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
*.log

# Misc
*.bak
*.tmp
